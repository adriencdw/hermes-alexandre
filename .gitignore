!hermes-init/memories/
!hermes-init/memories/**
cache/
*.db
*.db-shm
*.db-wal
state-snapshots/
image_cache/
audio_cache/
pastes/
processes.json

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# OS
.DS_Store
